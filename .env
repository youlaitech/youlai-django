# 应用配置
# DJANGO_SETTINGS_MODULE: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Django 密钥，生产环境务必修改且保密
# 生成：python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production

# 数据库（DB_ENGINE: mysql | postgresql）
DB_ENGINE=mysql
DB_HOST=www.youlai.tech
DB_PORT=3306
DB_NAME=youlai_admin_django
DB_USER=youlai
DB_PASSWORD=123456

# Redis
REDIS_HOST=www.youlai.tech
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# JWT（有效期单位：秒）
JWT_ACCESS_TOKEN_LIFETIME=7200
JWT_REFRESH_TOKEN_LIFETIME=604800
JWT_SECRET_KEY=SecretKey012345678901234567890123456789012345678901234567890123456789

# 邮件
EMAIL_HOST=smtp.youlai.tech
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=123456

# S3 对象存储（RustFS，默认本地）
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=rustfs-admin
S3_SECRET_KEY=rustfs-admin
S3_BUCKET_NAME=public
S3_SSL=false

# 短信
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_DOMAIN=dysmsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-shanghai
ALIYUN_SMS_SIGN_NAME=
SMS_REGISTER_TEMPLATE=
SMS_LOGIN_TEMPLATE=
SMS_CHANGE_MOBILE_TEMPLATE=
MOBILE_CODE_LENGTH=6
MOBILE_CODE_TIMEOUT=300

# 会话（SESSION_TYPE: jwt | redis-token）
SESSION_TYPE=jwt

# 图形验证码（CAPTCHA_CODE_TYPE: math | text；有效期单位：秒）
CAPTCHA_TYPE=circle
CAPTCHA_WIDTH=140
CAPTCHA_HEIGHT=44
CAPTCHA_INTERFERE_COUNT=1
CAPTCHA_TEXT_ALPHA=1.0
CAPTCHA_CODE_TYPE=math
CAPTCHA_CODE_LENGTH=4
CAPTCHA_FONT_NAME=SansSerif
CAPTCHA_FONT_WEIGHT=1
CAPTCHA_FONT_SIZE=28
CAPTCHA_EXPIRE_SECONDS=120

# 微信小程序
WX_MINIAPP_APP_ID=Your_AppId
WX_MINIAPP_APP_SECRET=Your_AppSecret

# AI 对话（OpenAI 兼容协议，地址需以 /v1 结尾，默认关闭）
AI_ENABLED=false
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 留空即关闭；本地开发用环境变量覆盖，不要提交自己的 Key
AI_API_KEY=
# 模型：qwen-plus / qwen-turbo / qwen-max 等
AI_MODEL=qwen-plus
